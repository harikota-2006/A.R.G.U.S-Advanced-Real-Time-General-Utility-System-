# Run python setup_config.py --legacy-env /path/to/env_for_astra.txt on the tablet.
# The setup command preserves configured provider values and generates security secrets.
TABLET_HOST=0.0.0.0
TABLET_PORT=8000
ARGUS_ORIGIN=http://localhost:8000
SESSION_TIMEOUT_SECONDS=900
FOLLOWUP_SECONDS=45

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
TAVILY_API_KEY=
TTS_VOICE=en-GB-RyanNeural

# Separate, private ntfy topics. TX is never inferred from RX.
NTFY_TX_URL=
NTFY_RX_URL=
NTFY_TOKEN=
NTFY_ATTACHMENT_HOSTS=
# Optional signed phone commands; use the same random 32+ character key on phone/hub.
NTFY_COMMAND_KEY=
# Phone-reachable hub base URL, e.g. http://100.100.10.20:8000 over Tailscale.
# Empty keeps HUD downloads local; phone notifications cannot include a download link.
ARGUS_PUBLIC_URL=
# Optional override; default is the recovered original Osiris dashboard with all layers.
DETECTIVE_URL=

# Created by setup_config.py; no insecure defaults.
ARGUS_PIN_HASH=
ARGUS_SESSION_SECRET=
ARGUS_DAEMON_KEY=

# Laptop-only file uses ARGUS_HUB_WS plus ARGUS_DAEMON_KEY; no provider keys.
# Example Tailscale URL: ws://100.100.10.20:8000/ws/workstation
ARGUS_HUB_WS=
ARGUS_WORKSPACE=
ARGUS_DOCUMENTS=
# Optional Windows alias mapping, for example {"editor":"C:/Apps/Editor.exe"}
ARGUS_APP_PATHS=
# Optional existing tablet storage overrides: ARGUS_DB_PATH and ARGUS_DATA_DIR.
